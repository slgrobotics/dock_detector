<?xml version="1.0"?>
<package format="3">
  <name>dock_detector</name><version>0.1.0</version>
  <description>LiDAR rectangular and V landmark perception for Nav2 docking.</description>
  <maintainer email="slg@quakemap.com">Sergei Grichine</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>python3-numpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend><exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend><exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend><exec_depend>launch</exec_depend><exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend><test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
